NODE_ENV=development

# Server Configuration
PORT=5000
DATABASE_PATH=./data/enqflow.db

# Authentication
# Required: Secret key for signing JWT tokens. Use a strong random string.
JWT_SECRET=your_jwt_secret_here

# Frontend Configuration
# URL of the customer web application
FRONTEND_URL=http://localhost:5173

# Desktop Application Configuration
# URL of the server (for desktop to connect to)
SERVER_URL=http://localhost:5000

# OTP Development Mode
OTP_DEV_MODE=true

# Push Notifications (Web Push)
# Optional but needed for push notifications. Generate using `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com

# Optional: OneDrive Backup Configuration
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_BACKUP_FOLDER=
